{
  "name": "moonlit-moments",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "build": "node cloudflare/build.mjs",
    "test": "npm run build && node --test cloudflare/worker.test.mjs",
    "dev": "npm run build && wrangler dev --local --port 4176",
    "dry-run": "npm run build && wrangler deploy --dry-run --outdir .local/worker-build",
    "db:migrate": "node cloudflare/validate-config.mjs && wrangler d1 migrations apply DB --remote",
    "deploy": "node cloudflare/validate-config.mjs && npm run build && wrangler deploy"
  },
  "devDependencies": {"wrangler": "4.162.0"},
  "engines": {"node": ">=22"}
}
