{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "moonlit-moments",
  "main": "cloudflare/worker.mjs",
  "compatibility_date": "2026-11-16",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "none",
    "run_worker_first": ["/", "/api/*", "/inbox*", "/login*"]
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "rest-a-while-mailbox",
    "database_id": "ff295fcb-10a3-4370-abdd-ad59cb37b77b",
    "migrations_dir": "cloudflare/migrations"
  }],
  "ratelimits": [
    {"name": "MAIL_RATE_LIMITER", "namespace_id": "731001", "simple": {"limit": 5, "period": 60}},
    {"name": "LOGIN_RATE_LIMITER", "namespace_id": "731002", "simple": {"limit": 5, "period": 60}}
  ]
}
